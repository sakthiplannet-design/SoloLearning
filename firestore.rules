rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /learners/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['stars', 'learned', 'quizzes', 'lessons', 'results'])
        && request.resource.data.stars is int && request.resource.data.stars >= 0
        && request.resource.data.quizzes is int && request.resource.data.quizzes >= 0
        && request.resource.data.learned is list && request.resource.data.learned.size() <= 500
        && request.resource.data.lessons is list && request.resource.data.lessons.size() <= 500
        && request.resource.data.results is list && request.resource.data.results.size() <= 50;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
